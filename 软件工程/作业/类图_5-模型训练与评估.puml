@startuml 类图_模型训练与评估
title 图 5 模型训练与评估类图

skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

class System {
    -status: String
    +generateEvaluationReport(): String
}

class AnnotationManager {
    -annotations: List<Annotation>
    +getLabeledData(): DataSet
}

class ModelManager {
    -svmModel: SVMModel
    +validateParameters(params: Map): boolean
    +createSVMModel(): SVMModel
    +evaluateModel(): EvaluationMetrics
    +generateEvaluationReport(): String
}

class SVMModel {
    -modelPath: String
    -featureDim: int
    +extractFeatures(dataSet: DataSet): FeatureVector
    +trainSVM(): void
    +saveModelFile(): void
    +generateEvaluationMetrics(): EvaluationMetrics
}

class TrainingThread {
    -progress: int
    -isTraining: boolean
    +start(): void
    +run(): void
    +updateProgress(progress: int): void
}

class UIManager {
    -progressBar: JProgressBar
    -metricsLabel: JLabel
    +displayTrainingProgress(): void
    +displayEvaluationMetrics(): void
}

class DataSet {
    -samples: List<Sample>
    +getSamples(): List
}

class EvaluationMetrics {
    -accuracy: double
    -precision: double
    -recall: double
    -f1Score: double
}

System --> AnnotationManager : uses
System --> ModelManager : uses
System --> UIManager : uses
ModelManager --> SVMModel : manages
TrainingThread --> SVMModel : trains

@enduml
