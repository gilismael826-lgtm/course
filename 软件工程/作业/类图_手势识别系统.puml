@startuml 手势识别系统类图
title 图 7 手势识别系统类图

skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
skinparam classFontStyle bold

' System 核心控制器
class System {
    -status: String
    -isRunning: boolean
    +start(): void
    +shutdown(): void
    +getStatus(): String
    +setStatus(status: String): void
}

' UIManager UI 界面管理
class UIManager {
    -mainWindow: JFrame
    -statusLabel: JLabel
    -deviceIndicator: JLabel
    +createMainUI(): void
    +displayReady(): void
    +updateDeviceIndicator(status: String): void
    +displayDeviceInfo(): void
    +highlightGestureType(type: GestureType): void
    +startTimeCounter(): void
    +updateStatusIndicator(status: String): void
    +displayTrainingProgress(): void
    +displayEvaluationMetrics(): void
    +updateRecognitionDisplay(): void
}

' DeviceManager 设备连接管理
class DeviceManager {
    -serialPort: SerialPort
    -isConnected: boolean
    +initialize(): void
    +connectToDevice(portID: String): void
    +checkConnection(): boolean
    +checkDataAcquisition(): boolean
    +receiveDataStream(): DataPacket
    +pushData(packet: DataPacket): void
    +getRealtimeSignal(): SignalData
    +updateConnectionStatus(status: String): void
}

' SignalProcessor 信号处理
class SignalProcessor {
    -isAcquiring: boolean
    -signalData: SignalData
    +initialize(): void
    +checkAcquisitionStatus(): boolean
    +createSignalData(): SignalData
    +startAcquisitionThread(): void
    +processSignal(): void
    +updateWaveform(display: WaveformDisplay): void
    +startRecognitionThread(): void
    +preprocessSignal(): void
    +extractFeatures(): FeatureVector
}

' AnnotationManager 标注管理
class AnnotationManager {
    -annotations: List<Annotation>
    -currentAnnotation: Annotation
    +initialize(): void
    +createAnnotation(): Annotation
    +getLabeledData(): DataSet
    +setAnnotationStatus(status: String): void
    +associateAnnotation(annotation: Annotation): void
}

' ModelManager 模型管理
class ModelManager {
    -svmModel: SVMModel
    -isModelLoaded: boolean
    +initialize(): void
    +validateParameters(params: Map): boolean
    +createSVMModel(): SVMModel
    +loadSVMModel(): SVMModel
    +evaluateModel(): EvaluationMetrics
    +generateEvaluationReport(): String
}

' SerialPort 串口
class SerialPort {
    -portID: String
    -baudRate: int
    +open(portID: String): void
    +close(): void
    +send(data: byte[]): void
    +receive(): byte[]
}

' Device 设备
class Device {
    -deviceID: String
    -isConnected: boolean
    +setConnected(connected: boolean): void
    +establishConnection(): void
    +startListening(): void
    +receiveDataStream(): DataPacket
}

' SignalData 信号数据
class SignalData {
    -timestamp: long
    -data: double[]
    -channelCount: int
    +getTimestamp(): long
    +getData(): double[]
    +setData(data: double[]): void
}

' WaveformDisplay 波形显示
class WaveformDisplay {
    -waveformPanel: JPanel
    -scaleFactor: double
    +updateWaveform(data: SignalData): void
    +refreshDisplay(): void
    +setScaleFactor(scale: double): void
}

' Annotation 标注记录
class Annotation {
    -gestureType: GestureType
    -startTime: long
    -endTime: long
    -signalData: SignalData
    +setStartTime(timestamp: long): void
    +setEndTime(timestamp: long): void
    +setGestureType(type: GestureType): void
    +getDuration(): long
}

' GestureType 手势类型
class GestureType {
    -name: String
    -id: int
    -iconPath: String
    +getName(): String
    +getID(): int
}

' SVMModel SVM 模型
class SVMModel {
    -modelPath: String
    -featureDim: int
    -classNames: String[]
    +extractFeatures(dataSet: DataSet): FeatureVector
    +trainSVM(): void
    +predict(features: FeatureVector): PredictionResult
    +saveModelFile(): void
    +loadModelFile(): void
    +generateEvaluationMetrics(): EvaluationMetrics
}

' TrainingThread 训练线程
class TrainingThread {
    -progress: int
    -isTraining: boolean
    +start(): void
    +run(): void
    +updateProgress(progress: int): void
}

' RecognitionResult 识别结果
class RecognitionResult {
    -gestureType: GestureType
    -confidence: double
    -timestamp: long
    -buffer: List<PredictionResult>
    +createBuffer(): void
    +addResult(result: PredictionResult): void
    +getLatestResult(): PredictionResult
}

' 关系定义
System --> UIManager : contains
System --> DeviceManager : contains
System --> SignalProcessor : contains
System --> AnnotationManager : contains
System --> ModelManager : contains

DeviceManager --> SerialPort : uses
DeviceManager --> Device : controls
SerialPort --> Device : connects

SignalProcessor --> SignalData : processes
SignalProcessor --> WaveformDisplay : updates

AnnotationManager --> Annotation : manages
Annotation --> GestureType : references

ModelManager --> SVMModel : manages
TrainingThread --> SVMModel : trains

Device --> DataPacket : receives
SignalProcessor --> FeatureVector : extracts
SVMModel --> PredictionResult : predicts
RecognitionResult --> PredictionResult : stores

@enduml
