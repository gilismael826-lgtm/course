@startuml 类图_系统启动
title 图 1 系统启动类图

skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

class System {
    -status: String
    -isRunning: boolean
    +start(): void
    +shutdown(): void
    +getStatus(): String
    +setStatus(status: String): void
}

class UIManager {
    -mainWindow: JFrame
    -statusLabel: JLabel
    +createMainUI(): void
    +displayReady(): void
}

class DeviceManager {
    -isConnected: boolean
    +initialize(): void
}

class SignalProcessor {
    -isAcquiring: boolean
    +initialize(): void
}

class AnnotationManager {
    -annotations: List
    +initialize(): void
}

class ModelManager {
    -isModelLoaded: boolean
    +initialize(): void
}

System --> UIManager : creates
System --> DeviceManager : creates
System --> SignalProcessor : creates
System --> AnnotationManager : creates
System --> ModelManager : creates

@enduml
