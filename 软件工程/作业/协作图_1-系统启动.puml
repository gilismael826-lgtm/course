@startuml 协作图_系统启动
skinparam nodesep 60
skinparam ranksep 60

rectangle ":System" as System
rectangle ":UIManager" as UIManager
rectangle ":DeviceManager" as DeviceManager
rectangle ":SignalProcessor" as SignalProcessor
rectangle ":AnnotationManager" as AnnotationManager
rectangle ":ModelManager" as ModelManager

System -right-> UIManager : 1:createMainUI()
System -down-> DeviceManager : 2:initialize()
System -down-> SignalProcessor : 3:initialize()
System -down-> AnnotationManager : 4:initialize()
System -right-> ModelManager : 5:initialize()
UIManager -down-> UIManager : 1.1:displayReady()
System -right-> System : 6:setStatus("就绪")

legend right
  图 1 系统启动协作图
endlegend

@enduml