@startuml 类图_实时手势识别
title 图 6 实时手势识别类图

skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

class System {
    -status: String
    +checkModelLoaded(): boolean
    +checkDataAcquisition(): boolean
}

class ModelManager {
    -svmModel: SVMModel
    -isModelLoaded: boolean
    +loadSVMModel(): SVMModel
}

class DeviceManager {
    -isAcquiring: boolean
    +checkDataAcquisition(): boolean
    +getRealtimeSignal(): SignalData
}

class SignalProcessor {
    -features: FeatureVector
    +startRecognitionThread(): void
    +preprocessSignal(): void
    +extractFeatures(): FeatureVector
}

class SVMModel {
    -modelPath: String
    -classNames: String[]
    +predict(features: FeatureVector): PredictionResult
}

class RecognitionResult {
    -gestureType: GestureType
    -confidence: double
    -timestamp: long
    -buffer: List
    +createBuffer(): void
    +addResult(result: PredictionResult): void
}

class UIManager {
    -recognitionDisplay: JLabel
    -confidenceThreshold: double
    +updateRecognitionDisplay(): void
    +checkConfidenceThreshold(): boolean
}

class SignalData {
    -data: double[]
    -timestamp: long
}

class FeatureVector {
    -features: double[]
    +getFeatures(): double[]
}

class PredictionResult {
    -gestureType: GestureType
    -confidence: double
}

class GestureType {
    -name: String
    -id: int
}

System --> ModelManager : uses
System --> DeviceManager : uses
System --> UIManager : uses
ModelManager --> SVMModel : loads
DeviceManager --> SignalData : returns
SignalProcessor --> RecognitionResult : updates
RecognitionResult --> UIManager : updates

@enduml
