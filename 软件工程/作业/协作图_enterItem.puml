@startuml
skinparam handwritten false
skinparam defaultFontSize 11
skinparam rectangleBackgroundColor #FEFECE
skinparam rectangleBorderColor black
skinparam rectangleBorderThickness 1.5
skinparam arrowThickness 1.5
skinparam arrowColor black

title 协作图 - enterItem(upc,qty) 系统操作

' 定义参与者
actor "外部" as External
rectangle ":POST" as POST
rectangle ":Sale" as Sale
rectangle ":ProductCatalog" as Catalog
rectangle ":ProductSpecification" as Spec
rectangle ":SalesLineItem" as SLISet
rectangle "s1:SalesLineItem" as SLI1

' 外部调用
External --> POST : enterItem(upc,qty)

' 消息1：创建Sale对象
POST --> Sale : 1:[new sale]create()

' 消息1.1和1.2：Sale创建并添加SalesLineItem
Sale --> SLISet : 1.1:create()
Sale --> SLISet : 1.2:add(s1)

' 消息2：获取产品规格
POST --> Catalog : 2:spec:=specification(upc)

' 消息2.1：查找产品规格
Catalog --> Spec : 2.1:spec:=find(upc)

' 消息3：创建销售明细项
POST --> Sale : 3:makeLineItem(spec,qty)

' 消息3.1：创建SalesLineItem实例
Sale --> SLI1 : 3.1:create(spec,qty)

@enduml
